{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceAttached",
  "description": "The agent attached an evidence pack to the reply. Topic lead.events.v1, key requestId. Full envelope, schemaVersion 1 (see docs/EVENTS.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "requestId",
    "leadId",
    "agentId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "uuidv7; the idempotency key"
    },
    "eventType": {
      "const": "EvidenceAttached"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "requestId": {
      "type": "string",
      "pattern": "^vr_"
    },
    "leadId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^ld_"
    },
    "agentId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^ag_"
    },
    "traceparent": {
      "type": [
        "string",
        "null"
      ],
      "description": "W3C trace context; null when no span is active"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packId": {
          "type": "string",
          "pattern": "^ep_"
        },
        "comparablesCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "comparablesRange": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "low": {
              "type": "number",
              "minimum": 0
            },
            "mid": {
              "type": "number",
              "minimum": 0
            },
            "high": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "low",
            "mid",
            "high"
          ],
          "description": "The range implied by the comparables this agent attached."
        }
      },
      "required": [
        "packId",
        "comparablesCount",
        "comparablesRange"
      ]
    }
  }
}
