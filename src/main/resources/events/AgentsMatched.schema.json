{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentsMatched",
  "description": "The eligibility lookup chose these agents (slot holders for the outcode, or the seller's own picks). A lookup, never a ranking. Topic valuation.requested.v1, key requestId. Full envelope, schemaVersion 1 (see docs/EVENTS.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "requestId",
    "leadId",
    "agentId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "uuidv7; the idempotency key"
    },
    "eventType": {
      "const": "AgentsMatched"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "requestId": {
      "type": "string",
      "pattern": "^vr_"
    },
    "leadId": {
      "type": "null"
    },
    "agentId": {
      "type": "null"
    },
    "traceparent": {
      "type": [
        "string",
        "null"
      ],
      "description": "W3C trace context; null when no span is active"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ag_"
          }
        },
        "eligibilityRule": {
          "enum": [
            "slot-holders-for-outcode",
            "seller-selected"
          ]
        }
      },
      "required": [
        "agentIds",
        "eligibilityRule"
      ]
    }
  }
}
